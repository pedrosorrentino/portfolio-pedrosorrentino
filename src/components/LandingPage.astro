---
import { siteConfig } from "@/utils/siteConfig";

interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const isSpanish = locale === "es";

const tagline = isSpanish ? siteConfig.taglineEs : siteConfig.taglineEn;
const greeting = isSpanish
  ? "UBICACIÓN DETECTADA: ITALIA, IT"
  : "LOCATION DETECTED: ITALY, IT";
const roleLabel = isSpanish ? "ROL PRINCIPAL" : "PRIMARY ROLE";
const statusLabel = isSpanish ? "ESTADO" : "STATUS";
const statusText = isSpanish
  ? "DISPONIBLE PARA PROYECTOS"
  : "AVAILABLE FOR PROJECTS";
const executeText = isSpanish
  ? "EJECUTAR PERFIL_GITHUB.EXE"
  : "EXECUTE GITHUB_PROFILE.EXE";
const systemText = isSpanish ? "SISTEMA SEGURO" : "SECURE SYSTEM";
const date = new Date().toLocaleDateString("en-GB", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>{siteConfig.name} | {tagline}</title>
    <meta name="description" content={`${siteConfig.name} - ${tagline}`} />
    <meta name="author" content={siteConfig.name} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0f1c" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${siteConfig.name} | ${tagline}`} />
    <meta property="og:description" content={tagline} />
    <meta property="og:image" content="/ogImage.webp" />

    <style is:global>
      @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100;400;500;700&display=swap");

      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        height: 100%;
        background: #0a0f1c !important;
      }

      body {
        min-height: 100vh;
        min-height: 100dvh;
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
        background: #0a0f1c !important;
        color: #e2e8f0 !important;
        line-height: 1.5;
        overflow: hidden; /* Prevent scrolling on the landing page */
      }

      ::selection {
        background: rgba(34, 197, 94, 0.3);
        color: #ffffff;
      }
    </style>
  </head>
  <body>
    <!-- Background grid effect -->
    <div class="bg-grid"></div>
    <div class="scanline"></div>

    <main class="hud-container">
      <!-- Top Bar -->
      <header class="hud-header">
        <div class="hud-item">{systemText} v2.5.0</div>
        <div class="hud-item grow-item"></div>
        <div class="hud-item">{date}</div>
      </header>

      <!-- Main Content -->
      <div class="content-wrapper">
        <div class="terminal-content">
          <p class="greeting-text fade-in-1">
            <span class="prompt">></span>
            {greeting}
          </p>

          <div class="name-block">
            <h1 class="name glitched-text">{siteConfig.name}</h1>
          </div>

          <div class="info-grid fade-in-2">
            <div class="info-item">
              <span class="label">{roleLabel} //</span>
              <span class="value">{tagline}</span>
            </div>

            <div class="info-item">
              <span class="label">{statusLabel} //</span>
              <span class="value status-active">
                <span class="blink-dot"></span>
                {statusText}
              </span>
            </div>
          </div>

          <div class="actions fade-in-3">
            <a
              href={siteConfig.githubUrl}
              class="cli-button"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="bracket">[</span>
              <span class="btn-text">{executeText}</span>
              <span class="bracket">]</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom Bar -->
      <footer class="hud-footer">
        <div class="hud-item">CPU: 12%</div>
        <div class="hud-item">MEM: 44%</div>
        <div class="hud-item grow-item"></div>
        <div class="hud-item">MODE: INSERT</div>
        <div class="hud-item">Ln 1, Col 1</div>
      </footer>
    </main>

    <style>
      /* Layout & Background */
      .hud-container {
        position: relative;
        height: 100vh;
        height: 100dvh;
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        z-index: 10;
      }

      .bg-grid {
        position: fixed;
        inset: 0;
        background-image:
          linear-gradient(rgba(30, 41, 59, 0.3) 1px, transparent 1px),
          linear-gradient(90deg, rgba(30, 41, 59, 0.3) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: radial-gradient(
          circle at center,
          black 40%,
          transparent 90%
        );
        z-index: 1;
        pointer-events: none;
      }

      .scanline {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0),
          rgba(255, 255, 255, 0) 50%,
          rgba(0, 0, 0, 0.1) 50%,
          rgba(0, 0, 0, 0.1)
        );
        background-size: 100% 4px;
        pointer-events: none;
        z-index: 5;
        opacity: 0.3;
      }

      /* HUD Header & Footer */
      .hud-header,
      .hud-footer {
        display: flex;
        gap: 1.5rem;
        font-size: 0.75rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .hud-item {
        display: flex;
        align-items: center;
      }

      .grow-item {
        flex-grow: 1;
        height: 1px;
        background: #1e293b;
        align-self: center;
        margin: 0 1rem;
      }

      /* Center Content */
      .content-wrapper {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center; /* Center horizontally */
        width: 100%;
      }

      .terminal-content {
        max-width: 900px;
        width: 100%;
      }

      /* Typography & Elements */
      .greeting-text {
        color: #22c55e;
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
        font-weight: 500;
        letter-spacing: 0.05em;
      }

      .prompt {
        margin-right: 0.5rem;
        animation: blink 1s step-end infinite;
      }

      .name-block {
        margin-bottom: 3rem;
        position: relative;
      }

      .name {
        font-size: clamp(3rem, 8vw, 6rem);
        font-weight: 700;
        line-height: 1;
        color: #f8fafc;
        text-transform: uppercase;
        letter-spacing: -0.03em;
        text-shadow: 0 0 40px rgba(59, 130, 246, 0.2);
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-bottom: 4rem;
        border-left: 2px solid #1e293b;
        padding-left: 2rem;
      }

      .info-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .label {
        font-size: 0.75rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .value {
        font-size: 1.125rem;
        color: #94a3b8;
        font-weight: 400;
      }

      .status-active {
        color: #e2e8f0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .blink-dot {
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        box-shadow: 0 0 10px #22c55e;
        animation: pulse 2s ease-in-out infinite;
      }

      /* Action Button */
      .cli-button {
        display: inline-block;
        font-size: 1.25rem;
        color: #22c55e; /* Matrix Green */
        text-decoration: none;
        transition: all 0.3s ease;
        padding: 0.5rem 0;
      }

      .bracket {
        color: #475569;
        transition: color 0.3s ease;
      }

      .btn-text {
        margin: 0 0.5rem;
        position: relative;
      }

      .btn-text::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 100%;
        height: 2px;
        background: #22c55e;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease;
      }

      .cli-button:hover .bracket {
        color: #94a3b8;
      }

      .cli-button:hover .btn-text {
        text-shadow: 0 0 15px rgba(34, 197, 94, 0.5);
      }

      .cli-button:hover .btn-text::after {
        transform: scaleX(1);
        transform-origin: left;
      }

      /* Animations */
      @keyframes blink {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0;
        }
      }

      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
      }

      .fade-in-1 {
        animation: fadeIn 0.8s ease-out forwards;
        opacity: 0;
        animation-delay: 0.2s;
      }
      .fade-in-2 {
        animation: fadeIn 0.8s ease-out forwards;
        opacity: 0;
        animation-delay: 0.6s;
      }
      .fade-in-3 {
        animation: fadeIn 0.8s ease-out forwards;
        opacity: 0;
        animation-delay: 1s;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Responsive */
      @media (max-width: 640px) {
        .hud-container {
          padding: 1rem;
        }
        .name {
          font-size: 13vw;
        } /* Even larger on mobile relatively */
        .info-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
          border-left: none;
          padding-left: 0;
          border-top: 2px solid #1e293b;
          padding-top: 1.5rem;
        }
        .hud-header,
        .hud-footer {
          font-size: 0.625rem;
        }
      }
    </style>
  </body>
</html>
